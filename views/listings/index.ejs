<% layout("/layouts/boilerplate") %>

<style>
 .filter-container {
    display: flex;
    align-items: center;
    width: 100%;
 }
 #filters{
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    flex:1
 }
 .filter{
    text-align: center;
    margin-right: 2rem;
    margin-top: 1rem;
    opacity: 0.75;
 }
 .filter:hover{
    opacity: 1;
    cursor: pointer;
    color: red;
    transition-duration: 0.45s;
    text-decoration: underline 2px;
 }

 .filter i{
    font-size: 1.5rem;
 }

 .filter p{
    font-size: 0.8rem;
 }

 .tax-info{
    display: none;
 }

 .tax-toggle{
    border: 2px solid black;
    border-radius: 1.5rem;
    height: 3rem;
    padding: 1rem;
    display: flex;
    align-items: center;
    margin-left: auto;
 }

 .filter-link {
    text-decoration: none;
    color: inherit;
}

.filter-link:hover {
    color: inherit;
}

.active-filter {
    color: red;
    opacity: 1;
}

.listing-grid {
    max-width: 100%;
    margin-left: 0;
    margin-right: 0;
}

</style>
<body>
    <!-- <h3>All listings</h3> -->
    <div class="filter-container">
        

        <div id="filters">

            <!-- Trending -->
            <a href="/listings" class="filter-link">
                <div class="filter">
                    <div><i class="fa-solid fa-fire"></i></div>
                    <p><b>Trending</b></p>
                </div>
            </a>

            <!-- Rooms -->
            <a href="<%= selectedCategory === 'Rooms' ? '/listings' : '/listings?category=Rooms' %>"
            class="filter-link">
                <div class="filter <%= selectedCategory === 'Rooms' ? 'active-filter' : '' %>">
                    <div><i class="fa-solid fa-bed"></i></div>
                    <p><b>Rooms</b></p>
                </div>
            </a>

            <!-- Iconic Cities -->
            <a href="<%= selectedCategory === 'Iconic Cities' ? '/listings' : '/listings?category=Iconic%20Cities' %>"
            class="filter-link">
                <div class="filter <%= selectedCategory === 'Iconic Cities' ? 'active-filter' : '' %>">
                    <div><i class="fa-solid fa-mountain-city"></i></div>
                    <p><b>Iconic Cities</b></p>
                </div>
            </a>

            <!-- Hills -->
            <a href="<%= selectedCategory === 'Hills' ? '/listings' : '/listings?category=Hills' %>"
            class="filter-link">
                <div class="filter <%= selectedCategory === 'Hills' ? 'active-filter' : '' %>">
                    <div><i class="fa-solid fa-mountain"></i></div>
                    <p><b>Hills</b></p>
                </div>
            </a>

            <!-- Castles -->
            <a href="<%= selectedCategory === 'Castles' ? '/listings' : '/listings?category=Castles' %>"
            class="filter-link">
                <div class="filter <%= selectedCategory === 'Castles' ? 'active-filter' : '' %>">
                    <div><i class="fa-brands fa-fort-awesome"></i></div>
                    <p><b>Castles</b></p>
                </div>
            </a>

            <!-- Pools -->
            <a href="<%= selectedCategory === 'Pools' ? '/listings' : '/listings?category=Pools' %>"
            class="filter-link">
                <div class="filter <%= selectedCategory === 'Pools' ? 'active-filter' : '' %>">
                    <div><i class="fa-solid fa-person-swimming"></i></div>
                    <p><b>Pools</b></p>
                </div>
            </a>

            <!-- Camping -->
            <a href="<%= selectedCategory === 'Camping' ? '/listings' : '/listings?category=Camping' %>"
            class="filter-link">
                <div class="filter <%= selectedCategory === 'Camping' ? 'active-filter' : '' %>">
                    <div><i class="fa-solid fa-campground"></i></div>
                    <p><b>Camping</b></p>
                </div>
            </a>

            <!-- Farms -->
            <a href="<%= selectedCategory === 'Farms' ? '/listings' : '/listings?category=Farms' %>"
            class="filter-link">
                <div class="filter <%= selectedCategory === 'Farms' ? 'active-filter' : '' %>">
                    <div><i class="fa-solid fa-cow"></i></div>
                    <p><b>Farms</b></p>
                </div>
            </a>

            <!-- Arctic -->
            <a href="<%= selectedCategory === 'Arctic' ? '/listings' : '/listings?category=Arctic' %>"
            class="filter-link">
                <div class="filter <%= selectedCategory === 'Arctic' ? 'active-filter' : '' %>">
                    <div><i class="fa-regular fa-snowflake"></i></div>
                    <p><b>Arctic</b></p>
                </div>
            </a>

            <!-- Domes -->
            <a href="<%= selectedCategory === 'Domes' ? '/listings' : '/listings?category=Domes' %>"
            class="filter-link">
                <div class="filter <%= selectedCategory === 'Domes' ? 'active-filter' : '' %>">
                    <div><i class="fa-solid fa-igloo"></i></div>
                    <p><b>Domes</b></p>
                </div>
            </a>

            <!-- Boats -->
            <a href="<%= selectedCategory === 'Boats' ? '/listings' : '/listings?category=Boats' %>"
            class="filter-link">
                <div class="filter <%= selectedCategory === 'Boats' ? 'active-filter' : '' %>">
                    <div><i class="fa-solid fa-ship"></i></div>
                    <p><b>Boats</b></p>
                </div>
            </a>

        </div>

        <!-- tax switch toggle -->
            <div class="tax-toggle">
                <div class="form-check-reverse form-switch">
                    <label id="form-check-label" for="flexSwitchCheckDefault">Taxes</label>
                    <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" role="switch" switch>
                </div>
            </div>
    </div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        
        <% if (everylisting.length === 0 && searchQuery) { %>

            <div class="d-flex flex-column justify-content-center align-items-center text-center w-100" style="min-height: 60vh;">

                <h2>No stays found!</h2>

                <p class="text-muted mb-2">
                    We couldn't find any listings matching
                    "<b><%= searchQuery %></b>".
                </p>

                <p>Try searching for another city or country.</p>

                <a href="/listings" class="btn btn-dark mt-2">
                    Explore all listings
                </a>

            </div>

        <% } else { %>
                <% for(let listing of everylisting){ %>
                    <a href="/listings/<%= listing._id %>" class="listing-link">
                        <div class="card col listing-card">
                            <img src="<%= listing.image.url %>" class="card-img-top"
                                alt="listing_image" style="height: 20rem;">
                            <div class="card-img-overlay"></div>
                            <div class="card-body">
                                <p class="card-text">
                                    <b><%= listing.title %></b><br>
                                    &#8377; <span class="listing-price"
                                        data-price="<%= listing.price %>">
                                        <%= listing.price %>
                                    </span> /night
                                    <i class="tax-info"></i>
                                </p>
                            </div>
                        </div>
                    </a>
                <% } %>
        <% } %>
    </div>

    <!-- javascript for tax switch -->
    <script>
        let taxSwitch = document.getElementById("flexSwitchCheckDefault");

        taxSwitch.addEventListener("click", () => {

            let taxInfo = document.getElementsByClassName("tax-info");
            let prices = document.getElementsByClassName("listing-price");

            for (let i = 0; i < prices.length; i++) {

                let originalPrice = Number(prices[i].dataset.price);

                if (taxSwitch.checked) {

                    let totalPrice = originalPrice * 1.18;

                    prices[i].innerText = Math.round(totalPrice);
                    // taxInfo[i].innerText = " Total including 18% GST";
                    taxInfo[i].style.display = "inline";

                } else {

                    prices[i].innerText = originalPrice;
                    // taxInfo[i].innerText = " 18% GST";
                    taxInfo[i].style.display = "none";

                }
            }
        });
    </script>
</body>