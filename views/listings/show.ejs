<% layout("/layouts/boilerplate") %>
<script>
    const maptoken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(currentlisting) %>;
</script>
    <div class="row mt-3">
        <div class="col-8 offset-3">
            <h3><%= currentlisting.title %></h3>
        </div>
        <div class="card mt-3 col-6 offset-3 show-card listing-card">
            <img src="<%= currentlisting.image.url %>" class="card-img-top show-img" alt="listing_image">

            <div class="card-body">
                <p class="card-text"><b>Owned by &colon;</b><%= currentlisting.owner.username %></p>
                <p class="card-text"><%= currentlisting.description %></p>
                <p class="card-text">&#8377;<%= currentlisting.price %></p>
                <p class="card-text"><%= currentlisting.location %></p>
                <p class="card-text"><%= currentlisting.country %></p>
            </div>
        </div>
        <br>

        <!-- //if condition to check wheteher the logged in user is the owner of opened listing or not -->
        <% if(currUser && currUser._id.equals(currentlisting.owner._id)){ %>
            <div class="btns">
                <a href="/listings/<%= currentlisting._id %>/edit" class="btn btn-dark edit-btn col-1 offset-3">Edit</a>
                <form method="post" action="/listings/<%= currentlisting._id %>?_method=DELETE">
                    <button class="btn btn-dark offset-5">Delete</button>
                </form>

            </div>
        <% } %>

        <!-- if condition to validate that only logged in user are able to create reviews -->
        <% if(currUser){ %>    
            <div class="col-8 offset-3 mb-3">
                <hr>
                <form method="post" action="/listings/<%= currentlisting._id %>/reviews" novalidate class="needs-validation">
                    <h4>Leave a Review</h4>
                    <!-- <div class="mb-3 mt-3">
                        <label for="rating" class="form-label">&colon; &nbsp;</label>
                        <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
                    </div> -->
                    <div class="mb-3 mt-3">
                        <label for="rating" class="form-label">Rating &colon; &nbsp;</label>
                        <fieldset class="starability-slot">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>
                    <div class="mb-3 mt-3">
                        <label for="comment" class="form-label">Comment &colon; &nbsp;</label>
                        <textarea name="review[comment]" id="comment" rows="5" cols="20" placeholder="Enter your Review" class="form-control" required></textarea>
                        <div class="invalid-feedback">This field cannot be empty</div>
                    </div>
                    <button class="btn btn-outline-dark">Submit</button>
                </form>
            </div>
        <% } %>
        <% if(currentlisting.reviews.length > 0){ %>
            <div class="col-8 offset-3 mb-3">
                <hr>
                <h4>All Reviews</h4>
                <div class="row">
                    <% for(review of currentlisting.reviews){ %>
                        <div class="card col-5 ms-3 mb-3">
                            <div class="card-body">
                                <h5 class="card-title">@<%= review.author.username %></h5>
                                <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                                <p class="card-text"><%= review.comment %></p>
                                <form method="post" action="/listings/<%= currentlisting._id %>/reviews/<%= review._id %>?_method=DELETE" class="mb-3">
                                    <button class="btn btn-sm btn-outline-dark">Delete</button>
                                </form>
                            </div>
                        </div>
                    <% } %>    
                </div>
                <hr>
            </div>
        <% } %>
        <div class="col-8 offset-3 mb-3">
            <h3>Where You'll be</h3>
            <div id="map"></div>
        </div>    
    </div>
<script src="/js/map.js"></script>
