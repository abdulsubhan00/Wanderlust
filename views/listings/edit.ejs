<% layout("/layouts/boilerplate") %>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h3>Edit listing</h3>
            <form method="post" action="/listings/<%= listing._id %>?_method=PUT" class="needs-validation" novalidate enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-label"><b>Title</b></label>
                    <input name="listing[title]" type="text" class="form-control" value="<%= listing.title %>" id="title" required>
                    <div class="invalid-feedback">Title is Mandatory</div>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label"><b>Description</b></label>
                    <textarea name="listing[description]" class="form-control" class="form-control" id="description" id="description" required><%= listing.description %></textarea>
                    <div class="invalid-feedback">Description is Mandatory</div>
                </div>

                <!-- to display low quality image -->
                <div class="mb-3"> 
                    <b>Original Image</b> <br>
                    <img src="<%= ogimage %>">
                </div>

                <div class="mb-3">
                    <label for="image" class="form-label"><b>Upload New Image</b></label>
                    <input name="listing[image]" type="file" class="form-control" id="image">
                </div>
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label"><b>Price</b></label>
                        <input name="listing[price]" type="text" class="form-control" value="<%= listing.price %>" id="price" required>
                        <div class="invalid-feedback">Price is Mandatory</div>
                    </div>

                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label"><b>Country</b></label>
                        <input name="listing[country]" type="text" class="form-control" value="<%= listing.country %>" id="country" required>
                        <div class="invalid-feedback">Country is Mandatory</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label"><b>Title</b></label>
                    <input name="listing[location]" type="text" class="form-control" value="<%= listing.location %>" id="location" required>
                    <div class="invalid-feedback">Location is Mandatory</div>
                </div>
                <button type="submit" class="btn btn-dark add-btn edit-btn">Update</button>
                <br><br>
            </form>
        </div>
    </div>
